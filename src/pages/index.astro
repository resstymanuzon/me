---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { getPosts, formatDate } from '../lib/blog';
import { site, traits, experience, education, skills, testimonials } from '../data/site';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
// Rendered case study bodies, shown in a modal when a work card is clicked
const caseStudies = await Promise.all(
  work.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
const posts = (await getPosts()).slice(0, 3);
---

<Base>
  <!-- Hero -->
  <section class="hero container">
    <p class="eyebrow">Product Manager · Engineer at heart</p>
    <h1>
      I build <span class="hl hl-yellow">marketplace</span> products with an
      <span class="hl hl-coral">engineer’s</span> brain.
    </h1>
    <p class="lede">
      I’m Ressty, a software engineer turned product manager with 7+ years in tech. I help
      consumer marketplaces grow, and I turn messy operational problems into AI-powered
      automation that ships.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href="#work">See my work <span aria-hidden="true">↓</span></a>
      <a class="btn btn-ghost" href="#contact">Get in touch</a>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="section container">
    <div class="about">
      <div>
        <p class="eyebrow">About</p>
        <h2 class="section-title">Engineer by training. Product person by curiosity.</h2>
      </div>
      <div class="about-copy">
        <p>
          I’ve always liked taking things apart to see how they work. That curiosity led me
          to a mechanical engineering degree at Texas A&amp;M, to R&amp;D work with Japanese
          clients, and eventually to writing full-stack code for one of the world’s largest
          freelancing marketplaces. My days were all about the <em>how</em>: how to build it,
          how to make it fast, how to ship it cleanly.
        </p>
        <p>
          But I kept asking <em>why</em>. Why does this feature matter to the business? Why
          would a client hire through us and not somewhere else? Which problem is worth
          solving first? I wanted to understand the strategy behind the work, not just carry
          it out, and that pulled me into product.
        </p>
        <p>
          Today I lead a team delivering AI and automation projects. I start with the business
          problem, use data to decide what to build, and bring my engineering background to
          help the team build it well.
        </p>
      </div>
    </div>

    <ul class="traits">
      {traits.map((t) => (
        <li class={`trait swatch-${t.color}`}>
          <h3>{t.title}</h3>
          <p>{t.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Work -->
  <section id="work" class="section container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 class="section-title">Problems I’ve shipped solutions for.</h2>
      </div>
      <div class="carousel-nav">
        <button type="button" class="nav-btn" data-carousel-prev aria-label="Previous case study">←</button>
        <button type="button" class="nav-btn" data-carousel-next aria-label="Next case study">→</button>
      </div>
    </div>
    <div class="carousel" data-carousel role="region" aria-roledescription="carousel" aria-label="Selected work">
      <ul class="track">
        {work.map((entry) => (
          <li class="slide"><WorkCard entry={entry} /></li>
        ))}
      </ul>
    </div>

    {caseStudies.map(({ entry, Content }) => (
      <dialog
        id={`work-${entry.id}`}
        class={`modal modal-case swatch-${entry.data.color}`}
        aria-labelledby={`work-${entry.id}-title`}
      >
        <div class="case-card">
        <div class="case-banner">
          <div class="case-top">
            <p class="case-meta">{entry.data.company} · {entry.data.role} · {entry.data.year}</p>
            <button type="button" class="modal-close" data-close-dialog aria-label="Close">✕</button>
          </div>
          <h3 id={`work-${entry.id}-title`}>{entry.data.title}</h3>
          <p class="case-summary">{entry.data.summary}</p>
          {entry.data.metrics.length > 0 && (
            <ul class="case-metrics">
              {entry.data.metrics.map((m) => (
                <li>
                  <span class="case-value">{m.value}</span>
                  <span class="case-label">{m.label}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
        <div class="case-body">
          <ul class="tags">
            {entry.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
          <div class="prose">
            <Content />
          </div>
        </div>
        </div>
      </dialog>
    ))}
  </section>

  <!-- Experience -->
  <section id="experience" class="section container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Experience</p>
        <h2 class="section-title">7+ years across engineering and product.</h2>
      </div>
      <a class="text-link" href={site.linkedin} target="_blank" rel="noopener">Full history on LinkedIn ↗</a>
    </div>

    <ol class="timeline">
      {experience.map((job) => (
        <li class="job">
          <p class="period">{job.period}</p>
          <div>
            <h3>{job.role}</h3>
            <p class="company">{job.company}</p>
            <ul>
              {job.points.map((point) => <li>{point}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>

    <div class="extras">
      <div class="extra">
        <h3>Education</h3>
        <p>{education.degree}</p>
        <p class="muted">{education.school}, {education.year}</p>
      </div>
      {Object.entries(skills).map(([group, items]) => (
        <div class="extra">
          <h3>{group}</h3>
          <ul class="tags">
            {items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Testimonials -->
  <section id="testimonials" class="section container">
    <p class="eyebrow">Testimonials</p>
    <h2 class="section-title">What teammates say.</h2>
    <ul class="quotes">
      {testimonials.map((t, i) => (
        <li class={`quote swatch-${t.color}`}>
          <blockquote>“{t.highlight}”</blockquote>
          <button type="button" class="read-more" data-open-dialog={`testimonial-${i}`}>
            Read full recommendation
          </button>
          <p class="who">
            <strong>{t.name}</strong>
            <span class="muted">{t.relation}</span>
          </p>
        </li>
      ))}
    </ul>

    {testimonials.map((t, i) => (
      <dialog id={`testimonial-${i}`} class={`modal swatch-${t.color}`} aria-labelledby={`testimonial-${i}-name`}>
        <div class="modal-head">
          <p class="who">
            <strong id={`testimonial-${i}-name`}>{t.name}</strong>
            <span class="muted">{t.relation}</span>
          </p>
          <button type="button" class="modal-close" data-close-dialog aria-label="Close">✕</button>
        </div>
        <div class="modal-body">
          {t.quote.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </dialog>
    ))}
  </section>

  <!-- Blog -->
  {site.showBlog && (
  <section id="blog" class="section container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Writing</p>
        <h2 class="section-title">Notes on product, marketplaces, and leading teams.</h2>
      </div>
      {posts.length > 0 && <a class="text-link" href="/blog/">All posts →</a>}
    </div>
    {posts.length > 0 ? (
      <ul class="posts">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <span class="post-date">{formatDate(post.data.pubDate)}</span>
              <span class="post-title">{post.data.title}{post.data.draft && ' (draft)'}</span>
              <span class="post-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted">The first posts are on their way.</p>
    )}
  </section>
  )}

  <!-- Contact -->
  <section id="contact" class="container">
    <div class="contact">
      <h2>Let’s build something people love.</h2>
      <p>
        Open to product roles, collaborations, and a good conversation about marketplaces, AI, or
        moving from engineering into product.
      </p>
      <div class="actions">
        <a class="btn btn-dark" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="btn btn-outline-dark" href={site.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    padding-block: clamp(56px, 10vw, 120px) 48px;
  }

  h1 {
    font-size: clamp(2.6rem, 7.5vw, 5.75rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.02;
    max-width: 15ch;
  }

  /* Rounded block drawn behind the word, trimmed to cover the letters (cap height to
     descenders) rather than the full line box. Highlighted words never wrap, so one
     shape always fits. */
  .hl {
    position: relative;
    z-index: 0;
    padding-inline: 0.12em;
    white-space: nowrap;
    color: var(--on-swatch);
  }

  .hl::before {
    content: '';
    position: absolute;
    inset: 16% 0 5%;
    z-index: -1;
    border-radius: 0.12em;
    background: var(--hl-color);
  }

  .hl-yellow {
    --hl-color: var(--yellow);
  }

  .hl-coral {
    --hl-color: var(--coral);
  }

  .lede {
    margin-top: 28px;
    max-width: 58ch;
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  /* About */
  .about {
    display: grid;
    gap: 32px;
  }

  .about-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: 1.15rem;
  }

  .traits {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    padding: 0;
    margin: 56px 0 0;
    list-style: none;
  }

  .trait {
    padding: 28px 24px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1.5px solid var(--line);
    border-top: 8px solid var(--swatch);
  }

  .trait h3 {
    font-size: 1.5rem;
    margin-bottom: 10px;
  }

  .trait p {
    color: var(--muted);
  }

  /* Work carousel */
  .carousel-nav {
    display: flex;
    gap: 10px;
  }

  .nav-btn {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    background: transparent;
    color: var(--ink);
    font-size: 1.3rem;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .nav-btn:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .track {
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 8px 0 12px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  /* Each slide leaves part of the next card visible so it reads as scrollable */
  .slide {
    display: flex;
    flex: 0 0 85%;
    scroll-snap-align: start;
  }

  .slide > :global(*) {
    flex: 1;
  }

  @media (min-width: 640px) {
    .slide {
      flex-basis: calc(50% - 10px);
    }
  }

  @media (min-width: 1024px) {
    .slide {
      flex-basis: 38%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      scroll-behavior: auto;
    }
  }

  /* Experience */
  .timeline {
    padding: 0;
    margin: 0;
    list-style: none;
    border-top: 1.5px solid var(--line);
  }

  .job {
    display: grid;
    gap: 8px;
    padding-block: 28px;
    border-bottom: 1.5px solid var(--line);
  }

  .period {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--muted);
  }

  .job h3 {
    font-size: 1.35rem;
  }

  .company {
    font-weight: 600;
    color: var(--coral);
    margin-top: 4px;
  }

  .job ul {
    margin: 12px 0 0;
    padding-left: 20px;
    color: var(--muted);
  }

  .job li + li {
    margin-top: 6px;
  }

  .extras {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 32px;
    margin-top: 48px;
  }

  .extra h3 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 12px;
  }

  /* Testimonials */
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    align-items: start;
    gap: 20px;
    padding: 0;
    margin: 48px 0 0;
    list-style: none;
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 28px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1.5px solid var(--line);
    border-top: 8px solid var(--swatch);
  }

  .quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .read-more {
    width: fit-content;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: underline;
    text-decoration-color: var(--swatch);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .read-more:hover {
    text-decoration-color: var(--ink);
  }

  .who {
    display: flex;
    flex-direction: column;
    font-size: 0.95rem;
  }

  .quote .who {
    padding-top: 16px;
    border-top: 1.5px solid var(--line);
  }

  /* Testimonial modal */
  .modal {
    width: min(640px, calc(100% - 32px));
    max-height: min(80vh, 720px);
    padding: 0;
    border: 0;
    border-top: 10px solid var(--swatch);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 24px 64px rgb(0 0 0 / 0.25);
  }

  .modal[open] {
    display: flex;
    flex-direction: column;
    animation: modal-in 0.2s ease;
  }

  .modal::backdrop {
    background: rgb(20 18 26 / 0.6);
    backdrop-filter: blur(4px);
  }

  .modal-head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 24px 16px;
    border-bottom: 1.5px solid var(--line);
  }

  .modal-head strong {
    font-family: var(--font-display);
    font-size: 1.25rem;
  }

  .modal-close {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1.5px solid var(--line);
    background: transparent;
    color: var(--ink);
    font-size: 1rem;
    cursor: pointer;
  }

  .modal-close:hover {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }

  .modal-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    overflow-y: auto;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  /* Case study modal: the dialog is a transparent full-screen layer and the card inside
     grows to fit its content. Tall cards scroll with the layer, never inside the card. */
  .modal-case {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    padding: 32px 16px;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .modal-case[open] {
    display: flex;
    overflow-y: auto;
  }

  /* Auto margins center the card when it fits and pin it to the top when it doesn't */
  .case-card {
    width: 100%;
    max-width: 880px;
    margin: auto;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    box-shadow: 0 24px 64px rgb(0 0 0 / 0.25);
  }

  .case-banner {
    padding: 24px 24px 32px;
    background: var(--swatch);
    color: var(--swatch-ink);
  }

  .case-top {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 16px;
  }

  .case-meta {
    padding-top: 8px;
    font-weight: 600;
    font-size: 0.9rem;
    opacity: 0.85;
  }

  .case-banner .modal-close {
    border-color: currentColor;
    color: inherit;
  }

  .case-banner .modal-close:hover {
    background: var(--swatch-ink);
    color: var(--swatch);
    border-color: var(--swatch-ink);
  }

  .case-banner h3 {
    margin-top: 12px;
    font-size: clamp(1.8rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .case-summary {
    margin-top: 14px;
    max-width: 60ch;
    font-size: 1.1rem;
  }

  .case-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .case-metrics li {
    display: flex;
    flex-direction: column;
  }

  .case-value {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .case-label {
    font-weight: 600;
  }

  .case-body {
    padding: 24px 24px 32px;
  }

  /* Tighter rhythm than full-page prose so the case study stays compact */
  .case-body .prose {
    max-width: none;
    font-size: 1rem;
  }

  .case-body .prose :global(h2) {
    margin: 28px 0 10px;
    font-size: 1.3rem;
  }

  .case-body .prose :global(ul),
  .case-body .prose :global(p) {
    margin-bottom: 12px;
  }

  .case-body .prose :global(li) {
    margin-bottom: 4px;
  }

  @media (min-width: 720px) {
    .case-banner,
    .case-body {
      padding-inline: 40px;
    }
  }

  @keyframes modal-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .modal[open] {
      animation: none;
    }
  }

  /* Blog preview */
  .posts {
    padding: 0;
    margin: 0;
    list-style: none;
    border-top: 1.5px solid var(--line);
  }

  .posts a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 24px;
    padding-block: 24px;
    border-bottom: 1.5px solid var(--line);
    text-decoration: none;
  }

  .post-date {
    grid-column: 1 / -1;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .post-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
  }

  .post-arrow {
    font-size: 1.4rem;
    transition: transform 0.2s ease;
  }

  .posts a:hover .post-arrow {
    transform: translateX(6px);
  }

  /* Contact */
  #contact {
    padding-bottom: clamp(64px, 10vw, 120px);
  }

  .contact {
    padding: clamp(32px, 6vw, 72px);
    border-radius: calc(var(--radius) * 1.5);
    background: var(--coral);
    color: var(--on-swatch);
  }

  .contact h2 {
    font-size: clamp(2.2rem, 6vw, 4.25rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    max-width: 14ch;
  }

  .contact p {
    margin-top: 20px;
    max-width: 52ch;
    font-size: 1.15rem;
  }

  .btn-dark {
    background: var(--on-swatch);
    color: #fff;
    border-color: var(--on-swatch);
    overflow-wrap: anywhere;
  }

  .btn-outline-dark {
    background: transparent;
    color: var(--on-swatch);
    border-color: var(--on-swatch);
  }

  .btn-outline-dark:hover {
    background: var(--on-swatch);
    color: #fff;
  }

  @media (min-width: 860px) {
    .about {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
    }

    .job {
      grid-template-columns: 200px 1fr;
      gap: 32px;
    }

    .posts a {
      grid-template-columns: 160px 1fr auto;
      align-items: baseline;
    }

    .post-date {
      grid-column: auto;
    }
  }
</style>

<script>
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  const track = carousel?.querySelector<HTMLElement>('.track');
  const prev = document.querySelector<HTMLButtonElement>('[data-carousel-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-carousel-next]');

  if (track && prev && next) {
    // Scroll by one slide (its width plus the gap between slides)
    const step = () => {
      const slide = track.querySelector<HTMLElement>('.slide');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return slide ? slide.offsetWidth + gap : track.clientWidth;
    };

    const max = () => track.scrollWidth - track.clientWidth;

    // Wrap around: past the last card goes back to the first, and before the first goes to the last
    prev.addEventListener('click', () => {
      if (track.scrollLeft <= 1) track.scrollTo({ left: max() });
      else track.scrollBy({ left: -step() });
    });
    next.addEventListener('click', () => {
      if (track.scrollLeft >= max() - 1) track.scrollTo({ left: 0 });
      else track.scrollBy({ left: step() });
    });
  }

  // Modals for testimonials and case studies
  document.querySelectorAll<HTMLButtonElement>('[data-open-dialog]').forEach((button) => {
    const dialog = document.getElementById(button.dataset.openDialog!) as HTMLDialogElement | null;
    if (!dialog) return;

    button.addEventListener('click', () => {
      dialog.showModal();
      dialog.scrollTop = 0;
    });
    dialog.querySelector('[data-close-dialog]')?.addEventListener('click', () => dialog.close());
    // Clicking the backdrop (the dialog element itself, outside its content) closes it
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

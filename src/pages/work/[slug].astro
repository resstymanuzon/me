---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, company, role, year, summary, metrics, tags, color } = entry.data;
const { Content } = await render(entry);
---

<Base title={title} description={summary}>
  <article>
    <header class={`banner swatch-${color}`}>
      <div class="container">
        <a class="back" href="/#work">← All work</a>
        <p class="meta">{company} · {role} · {year}</p>
        <h1>{title}</h1>
        <p class="summary">{summary}</p>
        {metrics.length > 0 && (
          <ul class="metrics">
            {metrics.map((m) => (
              <li>
                <span class="value">{m.value}</span>
                <span class="label">{m.label}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </header>

    <div class="container body">
      <ul class="tags">
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
      <div class="prose">
        <Content />
      </div>
      <a class="text-link" href="/#work">← Back to all work</a>
    </div>
  </article>
</Base>

<style>
  .banner {
    background: var(--swatch);
    color: var(--swatch-ink);
    padding-block: 48px 56px;
  }

  .back {
    display: inline-block;
    margin-bottom: 32px;
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
  }

  .back:hover {
    text-decoration: underline;
  }

  .meta {
    font-weight: 600;
    font-size: 0.95rem;
    opacity: 0.85;
  }

  h1 {
    margin-top: 12px;
    font-size: clamp(2.2rem, 6vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    max-width: 20ch;
  }

  .summary {
    margin-top: 20px;
    max-width: 60ch;
    font-size: 1.2rem;
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
  }

  .metrics li {
    display: flex;
    flex-direction: column;
  }

  .value {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .label {
    font-weight: 600;
  }

  .body {
    padding-block: 40px 96px;
  }

  .prose {
    margin-bottom: 48px;
  }
</style>
